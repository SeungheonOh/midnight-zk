// Test kernel of the G1 curve code (g1.glsl).

#extension GL_GOOGLE_include_directive : require

#include "g1.glsl"

// Operation codes (the crate's tests use the same numbers).
const uint OP_MADD = 0u;       // a + b_affine, or a - b_affine with the flag
const uint OP_ADD = 1u;        // a + b
const uint OP_FROM_AFFINE = 2u; // b_affine as XYZZ, negated with the flag

layout(std430, set = 0, binding = 0) readonly buffer InA { G1Xyzz a[]; };
layout(std430, set = 0, binding = 1) readonly buffer InB { G1Xyzz b[]; };
layout(std430, set = 0, binding = 2) readonly buffer InBAffine { G1Affine b_affine[]; };
layout(std430, set = 0, binding = 3) readonly buffer Flags { uint flags[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Out { G1Xyzz outv[]; };

layout(push_constant) uniform Params {
    uint op;
    uint n;
} params;

void main() {
    uint i = global_index();
    if (i >= params.n) return;
    G1Xyzz r = a[i];
    bool flag = flags[i] != 0u;
    switch (params.op) {
    case OP_MADD: g1_madd(r, b_affine[i], flag); break;
    case OP_ADD: g1_add(r, b[i]); break;
    default:
        r = g1_from_affine(b_affine[i]);
        g1_cneg(r, flag);
        break;
    }
    outv[i] = r;
}
