// Test kernel of the G1 curve code (g1.glsl).

#extension GL_GOOGLE_include_directive : require

#include "g1.glsl"

// Operation codes (the crate's tests use the same numbers).
const uint OP_MADD = 0u;       // a + b_affine, or a - b_affine with the flag
const uint OP_ADD = 1u;        // a + b
const uint OP_FROM_AFFINE = 2u; // b_affine as XYZZ, negated with the flag

layout(push_constant) uniform Params {
    uvec2 a;
    uvec2 b;
    uvec2 b_affine;
    uvec2 flags;
    uvec2 out_;
    uint op;
    uint n;
} params;

void main() {
    uint i = global_index();
    if (i >= params.n) return;
    G1Xyzz r = XYZZ_AT(params.a, i);
    bool flag = U32_AT(params.flags, i) != 0u;
    switch (params.op) {
    case OP_MADD: g1_madd(r, AFFINE_AT(params.b_affine, i), flag); break;
    case OP_ADD: g1_add(r, XYZZ_AT(params.b, i)); break;
    default:
        r = g1_from_affine(AFFINE_AT(params.b_affine, i));
        g1_cneg(r, flag);
        break;
    }
    g1_reduce(r);
    XYZZ_AT(params.out_, i) = r;
}
