// Test kernels of the field arithmetic (fr.glsl, fp.glsl): `field_test_fr`
// (FIELD_FR) and `field_test_fp` (FIELD_FP).

#extension GL_GOOGLE_include_directive : require

#if defined(FIELD_FR)
#include "fr.glsl"
#define E Fr
#define E_AT FR_AT
#define F(name) CAT(fr, name)
#elif defined(FIELD_FP)
#include "fp.glsl"
#define E Fp
#define E_AT FP_AT
#define F(name) CAT(fp, name)
#else
#error "FIELD_FR or FIELD_FP must be defined (build.rs)"
#endif

// Operation codes (the crate's tests use the same numbers).
const uint OP_ADD = 0u;
const uint OP_SUB = 1u;
const uint OP_MUL = 2u;
const uint OP_SQR = 3u;
const uint OP_NEG = 4u;
const uint OP_DBL = 5u;
const uint OP_IS_REDUCED = 6u;
const uint OP_ONE = 7u;
const uint OP_EQ = 8u;

layout(push_constant) uniform Params {
    uvec2 a;
    uvec2 b;
    uvec2 out_;
    uint op;
    uint n;
} params;

E flag(bool v) {
    E r = F(_zero)();
    r.l[0] = v ? 1u : 0u;
    return r;
}

E apply(uint op, E x, E y) {
    switch (op) {
    case OP_ADD: return F(_add)(x, y);
    case OP_SUB: return F(_sub)(x, y);
    case OP_MUL: return F(_mul)(x, y);
    case OP_SQR: return F(_sqr)(x);
    case OP_NEG: return F(_neg)(x);
    case OP_DBL: return F(_dbl)(x);
    case OP_IS_REDUCED: return flag(F(_is_reduced)(x));
    case OP_ONE: return F(_one)();
    case OP_EQ: return flag(F(_eq)(x, y));
    default: return F(_zero)();
    }
}

// out[i] = op(a[i], b[i]) for i < n.
void main() {
    uint i = global_index();
    if (i >= params.n) return;
    E_AT(params.out_, i) = apply(params.op, E_AT(params.a, i), E_AT(params.b, i));
}
