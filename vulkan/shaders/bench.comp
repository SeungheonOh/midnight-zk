// Throughput kernels of the arithmetic: `bench_fr_mul` (BENCH_FR_MUL),
// `bench_fp_mul` (BENCH_FP_MUL) and `bench_g1_madd` (BENCH_G1_MADD). Each
// invocation chains `iters` operations on its own values, so the result
// depends on every one of them.

#extension GL_GOOGLE_include_directive : require

// BENCH_*_MUL: (a, b, out); BENCH_G1_MADD: (table, out, unused).
layout(push_constant) uniform Params {
    uvec2 buf0;
    uvec2 buf1;
    uvec2 buf2;
    uint n;
    uint iters;
    // BENCH_G1_MADD: the number of table points minus one (a power of two
    // minus one)
    uint mask;
} params;

#if defined(BENCH_FR_MUL) || defined(BENCH_FP_MUL)

#if defined(BENCH_FR_MUL)
#include "fr.glsl"
#define E Fr
#define E_AT FR_AT
#define F(name) CAT(fr, name)
#else
#include "fp.glsl"
#define E Fp
#define E_AT FP_AT
#define F(name) CAT(fp, name)
#endif

// out[i] = a[i] * b[i]^iters.
void main() {
    uint i = global_index();
    if (i >= params.n) return;
    E x = E_AT(params.buf0, i);
    E y = E_AT(params.buf1, i);
    for (uint k = 0u; k < params.iters; k++) x = F(_mul)(x, y);
    E_AT(params.buf2, i) = x;
}

#elif defined(BENCH_G1_MADD)

#include "g1.glsl"


// out[i] = sum of table[(i + k) & mask] for k in 0..=iters.
void main() {
    uint i = global_index();
    if (i >= params.n) return;
    G1Xyzz acc = g1_from_affine(AFFINE_AT(params.buf0, i & params.mask));
    for (uint k = 1u; k <= params.iters; k++)
        g1_madd(acc, AFFINE_AT(params.buf0, (i + k) & params.mask), false);
    XYZZ_AT(params.buf1, i) = acc;
}

#else
#error "BENCH_FR_MUL, BENCH_FP_MUL or BENCH_G1_MADD must be defined (build.rs)"
#endif
