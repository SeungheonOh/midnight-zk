// Test kernel of the MSM mask (msm.glsl).

#extension GL_GOOGLE_include_directive : require

#include "msm.glsl"

layout(push_constant) uniform Params {
    uvec2 out_;
    uint i0;
    uint n;
} params;

// out[i] = the mask element i0 + i (a 64-bit index), as Montgomery limbs.
void main() {
    uint i = global_index();
    if (i >= params.n) return;
    uint c;
    uint lo = uaddCarry(params.i0, i, c);
    FR_AT(params.out_, i) = mask_elem(uvec2(lo, c));
}
