// A diagnostic kernel of the device context (src/device.rs).

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(push_constant) uniform Params {
    uvec2 out_;
    uint n;
} params;

// out[i] = i.
void main() {
    uint i = global_index();
    if (i >= params.n) return;
    U32_AT(params.out_, i) = i;
}
