// The G1 MSM kernels, a port of the Metal crate's `msm.metal`, itself ported
// from sppark `msm/pippenger.cuh`, `msm/sort.cuh` and
// `msm/batch_addition.cuh` (Copyright Supranational LLC, Apache-2.0,
// https://github.com/supranational/sppark, commit
// 08033103c14ff3c742e710b9463dde42acc0f058). build.rs compiles one kernel
// per define (MSM_DIGITS: `msm_digits`, ...).
//
// Layout (per batch of `len` points, `stride` the batch capacity):
// - digits: `nwins` rows of `stride` uint. `msm_digits` writes the signed
//   window digits (sppark's encoding: magnitude in the low bits, bit 31 the
//   sign); the sort replaces each row by the point indices sorted by bucket,
//   bit 31 the sign.
// - hist: `nwins` rows of `2^(wbits-1)` uint: after the sort, the inclusive
//   end offset of each bucket in its digits row.
// - buckets: `nwins` rows of `2^(wbits-1)` `G1Xyzz`; after `msm_integrate`,
//   the first `2 * threads` records of each row hold the partial sums the
//   host combines.
//
// `msm_ones` is the one kernel using subgroup operations. It reduces runs of
// 32 invocations, as the Metal kernel does in SIMD-groups of 32: in full
// subgroups of `ONES_LANES` invocations (specialization constant 1, a power
// of two up to 32: the host pins the subgroup width), then, below 32, across
// subgroups through shared memory.
//
// Push constants (addresses in Metal's buffer order, then the Metal kernel's
// parameter struct):
//   msm_digits        scalars, digits, hot; DigitsParams
//   msm_sort_count    digits, counts; SortParams
//   msm_sort_scan     counts, hist; SortParams
//   msm_sort_scatter  digits, counts, temps; SortParams
//   msm_sort_lower    digits, temps, hist; SortParams
//   msm_ones          ones, points, digits, hist
//   msm_bucket_guard  hist, hot; AccParams
//   msm_accumulate    buckets, points, digits, hist, hot; AccParams
//   msm_integrate     buckets; IntParams
// `scalars` and `points` are the addresses of the batch's first element
// (Metal's buffer offset `h_off`).

#extension GL_GOOGLE_include_directive : require
#if defined(MSM_ONES)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#endif

#include "fr.glsl"
#include "g1.glsl"
#include "msm.glsl"

// Device words other invocations of the same dispatch write and read after
// a `memoryBarrierBuffer(); barrier();` (Metal's `threadgroup_barrier`
// with `mem_device`).
layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer U32CRef {
    uint v;
};

#define U32C_AT(base, i) U32CRef(addr_at(base, i, 4u)).v

// ---------------------------------------------------------------------------
// Parameter structs (the host's, same layout).

// Scalar modes of `msm_digits`.
const uint MODE_MASKED = 1u; // s + r
const uint MODE_MASK = 2u;   // r

struct DigitsParams {
    uint len;    // scalars in this batch
    uint offset; // index of the batch's first scalar in the whole MSM
    uint nwins;
    uint wbits;
    uint stride; // digits row length
    uint mode;
};

struct SortParams {
    uint len;        // digits per row in this batch
    uint stride;     // digits row length
    uint win0;       // first window of the pass
    uint nwins;      // windows in the MSM
    uint groups;     // G: groups per window of the upper sort
    uint top_bits;
    uint low_bits;
    uint bits;       // wbits - 1 = top_bits + low_bits
    uint top_lsbits; // significant bits of (digit - 1) in the top window
};

struct AccParams {
    uint nwins;
    uint bits;      // wbits - 1
    uint stride;    // digits row length
    uint hot_limit; // the most points of one bucket (`HOT_BUCKET_LIMIT`)
};

struct IntParams {
    uint nwins;
    uint wbits;
    uint nbits;  // scalar bits: 255
    uint groups; // workgroups per window (a power of two)
};

// The largest top and low digit counts held in shared memory.
const uint MAX_TOP = 1u << 9;
const uint MAX_LOW = 1u << 12;

// ---------------------------------------------------------------------------
// Helpers of the sort.

// a & ~mask | mask & b (sppark `pack`, PTX lop3 0xb8).
uint pack(uint a, uint mask, uint b) {
    return (a & ~mask) | (mask & b);
}

uint lsbits_of(SortParams p, uint win) {
    return win == p.nwins - 1u ? p.top_lsbits : p.bits;
}

// The slice of `len` a group takes (sppark `upper_sort`).
void slice_of(uint len, uint groups, uint g, out uint base, out uint slice) {
    slice = len / groups;
    uint rem = len % groups;
    if (g < rem)
        base = ++slice * g;
    else
        base = slice * g + rem;
}

#if defined(MSM_SORT_SCAN) || defined(MSM_SORT_LOWER)

shared uint scan[gl_WorkGroupSize.x];

// Exclusive prefix sum over the workgroup, one value per invocation; `total`
// is the sum of all values. A scan in shared memory: it does not depend on
// the subgroup width.
uint group_exclusive_sum(uint x, out uint total) {
    const uint tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    scan[tid] = x;
    barrier();
    for (uint off = 1u; off < tpg; off <<= 1) {
        uint v = tid >= off ? scan[tid - off] : 0u;
        barrier();
        scan[tid] += v;
        barrier();
    }
    total = scan[tpg - 1u];
    uint r = scan[tid] - x;
    barrier();
    return r;
}

#endif

// The length of bucket `t` (0 for the bucket left to `msm_ones`) and its
// first sorted entry.
uint bucket_len(uvec2 hist, AccParams p, uint t, out uint idx) {
    const uint y = t >> p.bits, x = t & ((1u << p.bits) - 1u);
    const uint h = y << p.bits;
    idx = x != 0u ? U32_AT(hist, h + x - 1u) : 0u;
    return (x == 0u && y == 0u) ? 0u : U32_AT(hist, h + x) - idx;
}

// ---------------------------------------------------------------------------

#if defined(MSM_DIGITS)

// Scalars to digits (sppark `breakdown`), with the skew mask (msm.glsl).

layout(push_constant) uniform Push {
    uvec2 scalars;
    uvec2 digits;
    uvec2 hot;
    DigitsParams p;
} pc;

// The 32 bits of `s` from bit `off`: limbs i and i + 1 (none above limb 7),
// shifted right by off mod 32.
uint get_wval(Fr s, uint off) {
    const uint i = off / 32u, sh = off % 32u;
    uint lo = 0u, hi = 0u;
    [[unroll]] for (uint k = 0u; k < 8u; k++) {
        if (k == i) lo = s.l[k];
        if (k == i + 1u) hi = s.l[k];
    }
    return sh == 0u ? lo : (lo >> sh) | (hi << (32u - sh));
}

uint booth_encode(uint wval, uint wmask, uint wbits) {
    uint sign = (wval >> wbits) & 1u;
    wval = ((wval + 1u) & wmask) >> 1;
    return sign != 0u ? 0u - wval : wval;
}

// Resets `hot` at the start of each chunk's command buffer. In the mask mode
// `scalars` is not read.
void main() {
    const uint i = global_index();
    if (i == 0u) U32_AT(pc.hot, 0u) = 0u;
    if (i >= pc.p.len) return;

    uint c;
    const uvec2 mi = uvec2(uaddCarry(pc.p.offset, i, c), c);
    Fr s;
    if (pc.p.mode == MODE_MASK) {
        s = mask_elem(mi);
    } else {
        s = FR_AT(pc.scalars, i);
        if (pc.p.mode == MODE_MASKED) s = fr_add(s, mask_elem(mi));
    }

    // out of Montgomery form (sppark `s.from()`): s * 1 * 2^-256
    Fr raw_one = fr_zero();
    raw_one.l[0] = 1u;
    s = fr_mul(s, raw_one);

    // sppark `abs()`: make the value "positive", keep the sign
    Fr t;
    uint borrow = 0u;
    [[unroll]] for (int j = 0; j < 8; j++) t.l[j] = sub_bb(FR_P[j], s.l[j], borrow);
    uint msb = t.l[7] < s.l[7] ? 1u : 0u;
    if (msb != 0u) s = t;
    msb <<= 31;

    const uint wbits = pc.p.wbits;
    const uint wmask = 0xffffffffu >> (31u - wbits); // (1 << (wbits+1)) - 1

    uint bit0 = pc.p.nwins * wbits - 1u;
    for (uint win = pc.p.nwins - 1u; win != 0u; win--) {
        bit0 -= wbits;
        uint wval = get_wval(s, bit0);
        wval = booth_encode(wval, wmask, wbits);
        if (wval != 0u) wval ^= msb;
        U32_AT(pc.digits, win * pc.p.stride + i) = wval;
    }

    uint wval = s.l[0] << 1;
    wval = booth_encode(wval, wmask, wbits);
    if (wval != 0u) wval ^= msb;
    U32_AT(pc.digits, i) = wval;
}

#elif defined(MSM_SORT_COUNT)

// The per-window sort (sppark `sort.cuh`, the two-level path of `sort_row`):
// with no grid-wide barrier, sppark's cooperative `upper_sort` and
// `lower_sort` are four kernels, `msm_sort_count`, `msm_sort_scan`
// (prefix sums across groups), `msm_sort_scatter` and `msm_sort_lower`. A
// pass sorts `pass` windows from `win0`; the group index is
// `window * G + group`.

layout(push_constant) uniform Push {
    uvec2 digits;
    uvec2 counts;
    SortParams p;
} pc;

shared uint counters[MAX_TOP];

void main() {
    const uint gid = group_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const SortParams p = pc.p;
    const uint g = gid % p.groups, w = gid / p.groups, win = p.win0 + w;
    const uint ntop = 1u << p.top_bits;
    for (uint j = tid; j < ntop; j += tpg) counters[j] = 0u;
    barrier();

    uint base, slice;
    slice_of(p.len, p.groups, g, base, slice);
    const uint lshift = p.bits - lsbits_of(p, win);
    const uint pack_mask = 0xffffffffu << lshift;

    const uint src = win * p.stride + base;
    for (uint i = tid; i < slice; i += tpg) {
        uint val = U32_AT(pc.digits, src + i);
        uint pck = pack(base + i, pack_mask, (val - 1u) << lshift);
        if (val != 0u) atomicAdd(counters[(pck >> p.low_bits) & (ntop - 1u)], 1u);
    }
    barrier();

    // counts[window][top digit][group]
    for (uint j = tid; j < ntop; j += tpg)
        U32_AT(pc.counts, (w * ntop + j) * p.groups + g) = counters[j];
}

#elif defined(MSM_SORT_SCAN)

layout(push_constant) uniform Push {
    uvec2 counts;
    uvec2 hist;
    SortParams p;
} pc;

// One workgroup per window: the exclusive prefix sums of counts[window] in
// (top digit, group) order, in place, and each top digit's (start, length)
// in the histogram row at index `digit << low_bits` (where sppark's
// upper_sort leaves it for lower_sort).
void main() {
    const uint w = group_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const SortParams p = pc.p;
    const uint ntop = 1u << p.top_bits;
    const uint m = ntop * p.groups;
    const uint c = w * m;
    const uint chunk = (m + tpg - 1u) / tpg;
    const uint lo = min(m, tid * chunk), hi = min(m, lo + chunk);

    uint sum = 0u;
    for (uint j = lo; j < hi; j++) sum += U32C_AT(pc.counts, c + j);
    uint total;
    uint run = group_exclusive_sum(sum, total);
    for (uint j = lo; j < hi; j++) {
        uint v = U32C_AT(pc.counts, c + j);
        U32C_AT(pc.counts, c + j) = run;
        run += v;
    }
    memoryBarrierBuffer();
    barrier();

    const uint row = (p.win0 + w) * (1u << p.bits);
    for (uint t = tid; t < ntop; t += tpg) {
        uint start = U32C_AT(pc.counts, c + t * p.groups);
        uint end = t + 1u < ntop ? U32C_AT(pc.counts, c + (t + 1u) * p.groups) : total;
        U32_AT(pc.hist, row + (t << p.low_bits)) = start;
        U32_AT(pc.hist, row + (t << p.low_bits) + 1u) = end - start;
    }
}

#elif defined(MSM_SORT_SCATTER)

layout(push_constant) uniform Push {
    uvec2 digits;
    uvec2 counts;
    uvec2 temps;
    SortParams p;
} pc;

shared uint counters[MAX_TOP];

void main() {
    const uint gid = group_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const SortParams p = pc.p;
    const uint g = gid % p.groups, w = gid / p.groups, win = p.win0 + w;
    const uint ntop = 1u << p.top_bits;
    for (uint j = tid; j < ntop; j += tpg)
        counters[j] = U32_AT(pc.counts, (w * ntop + j) * p.groups + g);
    barrier();

    uint base, slice;
    slice_of(p.len, p.groups, g, base, slice);
    const uint lshift = p.bits - lsbits_of(p, win);
    const uint pack_mask = 0xffffffffu << lshift;

    const uint src = win * p.stride + base;
    const uint dst = w * p.stride;
    for (uint i = tid; i < slice; i += tpg) {
        uint val = U32_AT(pc.digits, src + i);
        uint pck = pack(base + i, pack_mask, (val - 1u) << lshift);
        if (val != 0u) {
            uint idx = atomicAdd(counters[(pck >> p.low_bits) & (ntop - 1u)], 1u);
            U32X2_AT(pc.temps, dst + idx) = uvec2(pck, pack(base + i, 0x80000000u, val));
        }
    }
}

#elif defined(MSM_SORT_LOWER)

layout(push_constant) uniform Push {
    uvec2 digits;
    uvec2 temps;
    uvec2 hist;
    SortParams p;
} pc;

shared uint counters[MAX_LOW];
shared uint base_len[2];

// One workgroup per (window, top digit): sppark `lower_sort`.
void main() {
    const uint gid = group_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const SortParams p = pc.p;
    const uint ntop = 1u << p.top_bits;
    const uint t = gid % ntop, w = gid / ntop, win = p.win0 + w;
    const uint nlow = 1u << p.low_bits;
    const uint row = win * (1u << p.bits) + (t << p.low_bits);
    // (base, len) through shared memory: the row is overwritten below, and
    // MoltenVK (SPIRV-Cross) re-reads a device load at its later uses, past
    // the barrier, where each invocation reading it into a register is not
    // enough
    if (tid == 0u) {
        base_len[0] = U32C_AT(pc.hist, row);
        base_len[1] = U32C_AT(pc.hist, row + 1u);
    }

    for (uint j = tid; j < nlow; j += tpg) counters[j] = 0u;
    // (base, len) is read before the row is written below
    memoryBarrierBuffer();
    barrier();
    const uint base = base_len[0], len = base_len[1];

    const uint src = w * p.stride + base;
    for (uint i = tid; i < len; i += tpg)
        atomicAdd(counters[U32X2_AT(pc.temps, src + i).x & (nlow - 1u)], 1u);
    barrier();

    // inclusive prefix sums of the counters, plus base: the end of each bucket
    const uint chunk = (nlow + tpg - 1u) / tpg;
    const uint lo = min(nlow, tid * chunk), hi = min(nlow, lo + chunk);
    uint sum = 0u;
    for (uint j = lo; j < hi; j++) sum += counters[j];
    uint total;
    uint run = group_exclusive_sum(sum, total) + base;
    for (uint j = lo; j < hi; j++) {
        run += counters[j];
        counters[j] = run;
        U32C_AT(pc.hist, row + j) = run;
    }
    barrier();

    const uint dst = win * p.stride;
    for (uint i = tid; i < len; i += tpg) {
        uvec2 val = U32X2_AT(pc.temps, src + i);
        uint idx = atomicAdd(counters[val.x & (nlow - 1u)], 0xffffffffu) - 1u;
        U32_AT(pc.digits, dst + idx) = val.y;
    }
}

#elif defined(MSM_ONES)

// sppark `batch_addition`: the bucket of digit 1 in window 0 (the first
// `hist[0]` sorted entries of row 0), summed by the whole grid, then reduced
// in runs of 32 invocations. The invocation whose grid index is a multiple of
// 32 writes one partial sum, so every one of the `threads / 32` records is
// written at every run. The workgroup is whole subgroups of at least
// `ONES_LANES` invocations, and a multiple of 32.

layout(push_constant) uniform Push {
    uvec2 ones;
    uvec2 points;
    uvec2 digits;
    uvec2 hist;
} pc;

// The invocations reduced with subgroup shuffles (a power of two up to 32).
layout(constant_id = 1) const uint ONES_LANES = 32u;

// The partial sums of each `ONES_LANES` invocations, below 32.
shared G1Xyzz parts[ONES_LANES < 32u ? gl_WorkGroupSize.x / ONES_LANES : 1u];

Fp shuffle_down(Fp a, uint delta) {
    Fp r;
    [[unroll]] for (int i = 0; i < 12; i++) r.l[i] = subgroupShuffleDown(a.l[i], delta);
    return r;
}

G1Xyzz shuffle_down(G1Xyzz a, uint delta) {
    G1Xyzz r;
    r.X = shuffle_down(a.X, delta);
    r.Y = shuffle_down(a.Y, delta);
    r.ZZZ = shuffle_down(a.ZZZ, delta);
    r.ZZ = shuffle_down(a.ZZ, delta);
    return r;
}

void main() {
    const uint tid = global_index(), nthreads = grid_threads();
    const uint lane = gl_SubgroupInvocationID;
    const uint ndigits = U32_AT(pc.hist, 0u);

    G1Xyzz acc = g1_inf();
    for (uint i = tid; i < ndigits; i += nthreads) {
        uint digit = U32_AT(pc.digits, i);
        g1_madd(acc, AFFINE_AT(pc.points, digit & 0x7fffffffu), (digit >> 31) != 0u);
    }

    // reduce each run of ONES_LANES lanes into its first lane (a lane reads
    // only lanes above it within the subgroup)
    for (uint off = 1u; off < ONES_LANES;) {
        G1Xyzz down = shuffle_down(acc, off);
        off <<= 1;
        if ((lane & (off - 1u)) == 0u) g1_add(acc, down);
    }
    // then each run of 32 into its first invocation, through shared memory
    if (ONES_LANES < 32u) {
        const uint lid = gl_LocalInvocationID.x;
        if ((lid & (ONES_LANES - 1u)) == 0u) parts[lid / ONES_LANES] = acc;
        barrier();
        if ((lid & 31u) == 0u) {
            for (uint j = 1u; j < 32u / ONES_LANES; j++) g1_add(acc, parts[lid / ONES_LANES + j]);
        }
    }

    if ((tid & 31u) == 0u) XYZZ_AT(pc.ones, tid / 32u) = acc;
}

#elif defined(MSM_BUCKET_GUARD)

// The hot-bucket bound (`HOT_BUCKET_LIMIT` of the host): one invocation per
// bucket; `hot` is set when a bucket (the bucket of `msm_ones` excepted)
// holds more than `hot_limit` points. Then `msm_accumulate` writes infinity
// to every bucket without reading any point, and the host declines the call
// (it reads `hot` after the command buffer).

layout(push_constant) uniform Push {
    uvec2 hist;
    uvec2 hot;
    AccParams p;
} pc;

void main() {
    const uint t = global_index();
    if (t >= (pc.p.nwins << pc.p.bits)) return;
    uint idx;
    if (bucket_len(pc.hist, pc.p, t, idx) > pc.p.hot_limit) atomicExchange(U32_AT(pc.hot, 0u), 1u);
}

#elif defined(MSM_ACCUMULATE)

// sppark `accumulate`: one invocation per bucket (window y, bucket x) sums
// its sorted points with mixed additions into XYZZ. The bucket of digit 1 in
// window 0 is left to `msm_ones`.

layout(push_constant) uniform Push {
    uvec2 buckets;
    uvec2 points;
    uvec2 digits;
    uvec2 hist;
    uvec2 hot;
    AccParams p;
} pc;

shared uint lens[gl_WorkGroupSize.x];
shared uint slot[gl_WorkGroupSize.x];

void main() {
    const uint g = global_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const AccParams p = pc.p;
    const uint total = p.nwins << p.bits;
    // the same value for every invocation: the whole grid returns here,
    // before any barrier
    if (U32_AT(pc.hot, 0u) != 0u) {
        if (g < total) XYZZ_AT(pc.buckets, g) = g1_inf();
        return;
    }
    uint idx;
    const uint mine = g < total ? bucket_len(pc.hist, p, g, idx) : 0u;
    // the workgroup's buckets by load, longest first: each subgroup takes
    // buckets of similar length (invocations past the end rank last)
    lens[tid] = mine;
    barrier();
    uint rank = 0u;
    for (uint j = 0u; j < tpg; j++) {
        uint l = lens[j];
        rank += (l > mine || (l == mine && j < tid)) ? 1u : 0u;
    }
    slot[rank] = tid;
    barrier();
    const uint t = g - tid + slot[tid];
    if (t >= total) return;
    const uint y = t >> p.bits;
    uint len = bucket_len(pc.hist, p, t, idx);

    G1Xyzz bucket;
    if (len != 0u) {
        uint digs = y * p.stride + idx;
        uint digit = U32_AT(pc.digits, digs++);
        bucket = g1_from_affine(AFFINE_AT(pc.points, digit & 0x7fffffffu));
        g1_cneg(bucket, (digit >> 31) != 0u);
        while (--len != 0u) {
            digit = U32_AT(pc.digits, digs++);
            g1_madd(bucket, AFFINE_AT(pc.points, digit & 0x7fffffffu), (digit >> 31) != 0u);
        }
    } else {
        bucket = g1_inf();
    }
    XYZZ_AT(pc.buckets, t) = bucket;
}

#elif defined(MSM_INTEGRATE)

// sppark `integrate`: one workgroup per window, each invocation a contiguous
// run of `2^(wbits-1) / threads` buckets: the weighted running sum `p` and
// the plain sum `acc` of its run, written over the start of the row (records
// 2 tid and 2 tid + 1) after every invocation has read its run. In the top
// window, whose digits have fewer bits, a bucket of the sort is a sub-bucket
// of `2^(wbits - lsbits)` adjacent ones and the running sum takes only whole
// buckets (`mask`). The workgroup size is a power of two below
// `2^(wbits-1)`.
//
// With `groups` workgroups per window, workgroup g of a window takes the
// g-th part of its row: its invocations are runs g * threads + tid of the
// window, and it writes its records over the start of its own part.

layout(push_constant) uniform Push {
    uvec2 buckets;
    IntParams p;
} pc;

void main() {
    const uint gid = group_index(), tid = gl_LocalInvocationID.x, tpg = gl_WorkGroupSize.x;
    const IntParams p = pc.p;
    const uint bid = gid / p.groups;
    const uint nthrbits = findLSB(tpg) + findLSB(p.groups);
    uint i = 1u << (p.wbits - 1u - nthrbits);
    const uint row = (bid << (p.wbits - 1u)) + (gid % p.groups) * tpg * i;
    const uint run = row + tid * i;

    uint mask = 0u;
    if ((bid + 1u) * p.wbits > p.nbits) {
        uint lsbits = p.nbits - bid * p.wbits;
        mask = (1u << (p.wbits - lsbits)) - 1u;
    }

    G1Xyzz res, acc = XYZZ_AT(pc.buckets, run + --i);
    if ((i & mask) != 0u)
        res = g1_inf();
    else
        res = acc;

    G1Xyzz q = res;
    while (i-- != 0u) {
        q = XYZZ_AT(pc.buckets, run + i);
        uint pc_ = (i & mask) != 0u ? 2u : 0u;
        do {
            g1_add(q, acc);
            if (pc_ == 1u) {
                res = q;
            } else {
                acc = q;
                if (pc_ == 0u) q = res;
            }
        } while (++pc_ < 2u);
    }

    // every invocation has read its run before the row is written; no
    // invocation reads a record written here, so the records need no
    // `coherent` (which MoltenVK cannot translate on a struct)
    memoryBarrierBuffer();
    barrier();

    XYZZ_AT(pc.buckets, row + 2u * tid) = q;
    XYZZ_AT(pc.buckets, row + 2u * tid + 1u) = acc;
}

